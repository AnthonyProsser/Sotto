#!/bin/zsh
set -euo pipefail

NIGHT_HOME="${0:A:h:h}"
ROOT="${SOTTO_NIGHT_ROOT:-${NIGHT_HOME:h:h}}"
export OPENCODE_CONFIG="$NIGHT_HOME/opencode.json"
export OPENCODE_CONFIG_DIR="$NIGHT_HOME/ocdir"
export OPENCODE_DISABLE_AUTOUPDATE=1

mkdir -p "$NIGHT_HOME/state"
MODEL="$(grep -v '^#' "$NIGHT_HOME/allowlist.txt" | grep -v '^$' | head -1)"
REQUESTED="${1:-$MODEL}"

if [[ "$REQUESTED" != "$MODEL" ]]; then
  print -u2 "REFUSED non-allowlisted model: $REQUESTED"
  exit 2
fi

OUT="$NIGHT_HOME/state/ping.json"
: > "$OUT"

python3 - "$ROOT" "$MODEL" "$OUT" <<'PY'
import subprocess, sys
root, model, out = sys.argv[1], sys.argv[2], sys.argv[3]
cmd = [
    "opencode", "run",
    "--dir", root,
    "--agent", "ping",
    "--model", model,
    "--format", "json",
    "--title", "sotto-night-ping",
    "Reply with the single word PONG and do nothing else. Do not use tools.",
]
with open(out, "w") as fh:
    try:
        proc = subprocess.run(cmd, stdout=fh, stderr=subprocess.PIPE, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        print("ping timed out after 180s", file=sys.stderr)
        sys.exit(5)
if proc.returncode != 0:
    print(proc.stderr[-4000:] if proc.stderr else "opencode ping failed", file=sys.stderr)
    sys.exit(proc.returncode or 1)
PY

python3 "$NIGHT_HOME/bin/night-parse.py" check-models "$OUT" "$NIGHT_HOME/allowlist.txt"
python3 "$NIGHT_HOME/bin/night-parse.py" require-text "$OUT" PONG
